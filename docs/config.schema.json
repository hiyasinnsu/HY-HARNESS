      "type": "string",
      "enum": [
        "untrusted",
        "on-request",
        "on-failure",
        "never"
      ],
      "description": "How prompt decisions are handled (CP-05). untrusted asks for every prompt (default)."
    },
    "sandboxMode": {
      "type": "string",
