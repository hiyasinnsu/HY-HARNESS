      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "extends": {
            "type": "string",
            "description": "Inherit another profile first (cycles are rejected)."
          },
          "denyRead": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "readOnly": {
            "type": "array",
            "items": {
              "type": "string"
            }
