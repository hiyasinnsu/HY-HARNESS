{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hy-harness.invalid/config.schema.json",
  "title": "HY-HARNESS user configuration",
  "description": "User config at %APPDATA%\\hy-harness\\config.json (override the directory with HY_CONFIG_DIR). Unknown keys are ignored by the loader.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "profiles": {
      "type": "object",
      "description": "Named overlays selected with --profile (merged over the user config).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "$ref": "#"
        }
      }
    },
    "workspaceRoots": {
      "type": "array",
      "description": "Additional roots for every workspace; the workspace root is always main. The GUI stores roots per workspace in workspaceRootsByWorkspace instead.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "writable": {
            "type": "boolean"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    "workspaceRootsByWorkspace": {
      "type": "object",
      "description": "Additional roots per workspace, keyed by the primary root path (lower-cased on Windows). Written by the GUI roots dialog.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "writable": {
              "type": "boolean"
            }
          },
          "required": [
            "path"
          ]
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worker": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "ollama",
                "deepseek",
                "openai-compatible",
                "openai-responses",
                "opencode",
                "gemini",
                "anthropic",
                "mock"
              ],
              "description": "Adapter used for this role."
            },
            "model": {
              "type": "string"
            },
            "baseUrl": {
              "type": "string"
            },
            "apiKeyEnv": {
              "type": "string",
              "description": "Environment variable that holds the key (preferred)."
            },
            "apiKey": {
              "type": "string",
              "description": "Directly stored key; takes precedence over apiKeyEnv."
            },
            "apiKeySecret": {
              "type": "string",
              "description": "Name in `secrets` holding a DPAPI reference (CP-08). Set it with `hy secret set <name>`."
            },
            "effort": {
              "type": "string",
              "description": "Provider reasoning effort (none/minimal/low/medium/high/xhigh/max)."
            },
            "contextWindowTokens": {
              "type": "integer",
              "minimum": 1
            },
            "maxOutputTokens": {
              "type": "integer",
              "minimum": 1
            },
            "temperature": {
              "type": "number",
              "minimum": 0
            },
            "verbosity": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "description": "Responses API text.verbosity (openai-responses only)."
            },
            "reasoningSummary": {
              "type": "string",
              "enum": [
                "auto",
                "concise",
                "detailed",
                "none"
              ],
              "description": "Responses API reasoning.summary (openai-responses only)."
            },
            "serviceTier": {
              "type": "string",
              "enum": [
                "auto",
                "default",
                "flex",
                "priority"
              ],
              "description": "Responses API service_tier (openai-responses only)."
            },
            "pricing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "inputPerMTokUsd": {
                  "type": "number",
                  "minimum": 0
                },
                "cachedInputPerMTokUsd": {
                  "type": "number",
                  "minimum": 0
                },
                "outputPerMTokUsd": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "inputPerMTokUsd",
                "outputPerMTokUsd"
              ]
            },
            "nativeTools": {
              "type": "boolean"
            },
            "vision": {
              "type": "boolean",
              "description": "Whether the model accepts image input (read_image). Defaults to a provider/model heuristic."
            }
          },
          "required": [
            "provider",
            "model"
          ]
        },
