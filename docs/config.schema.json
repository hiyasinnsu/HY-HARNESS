      "type": "object",
      "additionalProperties": false,
      "properties": {
        "envPassthrough": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraWritableRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "legacyUnconfined": {
          "type": "boolean",
          "description": "Keep the pre-0.5 default (unconfined) without --unsafe-unconfined. Confinement is recommended."
        },
        "denyRead": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths the confined token must not read (CP-02). Supports ~, $HOME and %VAR%; directories include their children."
        },
        "readOnly": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Workspace subdirectories that stay readable but not writable for confined commands (CP-02)."
        }
      }
    },
