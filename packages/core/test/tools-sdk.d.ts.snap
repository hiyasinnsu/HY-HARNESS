declare namespace tools {
  type Job = { jobId: string; command: string; state: 'running' | 'exited' | 'killed'; exitCode?: number | null; outputBytes: number }
  type NoteCount = { entries: number; tokens: number }
  /** Read a workspace file (read before editing). Added roots use root:path. */
  function readFile(args: { path: string; startLine?: number; endLine?: number }): Promise<{ content: string; totalLines: number; truncated: boolean }>
  /** Unified diff with ---/+++ file headers and numbered @@ hunks, or file + content. The *** Begin Patch format is not supported. Read existing files first. Split large edits into smaller calls. Added roots: whole-file content with root. */
  function applyPatch(args: { patch: string } | { file: string; content: string; root?: string }): Promise<{ appliedFiles: string[]; created: string[]; deleted: string[]; warnings: string[] }>
  /** Run a command in the platform shell. On Windows use PowerShell, not Bash; avoid Unix grep/head/find and Bash heredocs. Write multiline Python to a .py file. Format mixed tables separately with Format-Table -AutoSize or ConvertTo-Json. The default cwd is the workspace root (or the persistent session cwd); pass cwd within the selected root and quote paths with spaces. Read an existing file before changing it. For Git use git_status, git_prepare, git_commit and git_push when offered. Inspect exitCode and output: chained commands may report only the last command's status. After foregroundWaitMs it becomes a job. root selects the workspace root (default main). */
  function shell(args: { command: string; root?: string; cwd?: string; foregroundWaitMs?: number; hardTimeoutMs?: number; persistent?: boolean; stdinPipe?: boolean; tty?: boolean }): Promise<{ status: 'completed' | 'backgrounded'; exitCode?: number | null; stdout: string; stderr: string; jobId?: string | null; gap?: string }>
  namespace search {
    /** Root-relative paths matching a glob (docs/*.md); skips .git, node_modules, .gitignore'd. root:* = all roots. */
    function glob(args: { pattern: string; root?: string; maxResults?: number }): Promise<{ files: string[]; truncated: boolean; note?: string }>
    /** Regex lines; optional path glob; same skips. root:* = all roots. */
    function grep(args: { pattern: string; root?: string; glob?: string; ignoreCase?: boolean; maxResults?: number }): Promise<{ matches: { path: string; line: number; text: string }[]; truncated: boolean; filesSearched: number; note?: string }>
  }
  namespace jobs {
    /** State of a background job. */
    function status(args: { jobId: string }): Promise<Job>
    /** A page of a job's output from offset. */
    function output(args: { jobId: string; offset?: number; maxBytes?: number }): Promise<{ data: string; nextOffset: number; totalBytes: number; eof: boolean }>
    /** Wait up to timeoutMs for a job to finish. */
    function wait(args: { jobId: string; timeoutMs?: number }): Promise<Job>
    /** Kill a job and its process tree. */
    function kill(args: { jobId: string }): Promise<Job>
  }
  namespace rationale {
    /** A note that survives compaction (max 12 / ~1500 tokens). */
    function upsert(args: { key: string; rule: string; rationale?: string }): Promise<NoteCount>
    /** Replace oldKey with a new note. */
    function supersede(args: { oldKey: string; newKey: string; rule: string; rationale?: string }): Promise<NoteCount>
    /** Delete a note. */
    function remove(args: { key: string }): Promise<NoteCount>
  }
}
