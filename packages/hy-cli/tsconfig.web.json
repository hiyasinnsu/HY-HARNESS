{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": [],
    "outDir": "web/dist",
    "rootDir": "web/src",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["web/src/**/*.ts"],
  "exclude": ["web/src/**/*.test.ts"]
}
